# Copy this file to ".env" and fill in your real key.
# .env is git-ignored — never commit real keys.

# Which provider explain_anomaly() uses: "anthropic" (paid) or "gemini" (free).
LLM_PROVIDER=gemini

# --- Anthropic (Phase 4's requested provider; PAID — needs API credits) ------
# Get a key at https://console.anthropic.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Default model is claude-opus-4-8. For a tight budget use the cheapest model:
#   ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-4-8

# --- Google Gemini (free tier via Google AI Studio; no billing) --------------
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash
